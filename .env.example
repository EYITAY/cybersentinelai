# Copy to `.env.local` (recommended for local dev) or `.env`
#
# Frontend (Vite)
# These are exposed to the browser because of the VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (Express)
# Gemini
GEMINI_API_KEY=

# Supabase Admin (SERVICE ROLE key - keep secret, server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GREENHORN=
STRIPE_PRICE_VIGILANTE=
STRIPE_PRICE_SENTINEL=

# Optional
FRONTEND_URL=http://localhost:5173
PORT=3001
